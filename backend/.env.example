# ===========================================================================
# J-ONE HOTEL & LODGE — Backend environment variables
# Copy to ".env" and fill in real values. NEVER commit a filled .env file.
# ===========================================================================

# --- Core Django -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DJANGO_DEBUG=True
# Comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Which settings module manage.py uses: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database --------------------------------------------------------------
# Development default is SQLite (nothing to set).
# Production: provide EITHER a full MySQL DATABASE_URL:
#   DATABASE_URL=mysql://user:password@host:3306/jone_hotel
# ...or the individual components below:
# DATABASE_URL=
# DB_NAME=jone_hotel
# DB_USER=jone
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Frontend / CORS -------------------------------------------------------
# Public URL of the independently hosted HTML/CSS/JS frontend (no trailing slash)
# Local dev (VS Code Live Server): http://127.0.0.1:5500
# Production (Vercel):             https://jonehotel.vercel.app
FRONTEND_URL=http://127.0.0.1:5500
# Optional explicit Paystack callback page (defaults to {FRONTEND_URL}/payment-verify.html)
PAYMENT_CALLBACK_URL=
# Production ONLY: comma-separated exact origins allowed to call the API.
# MUST include the deployed frontend origin exactly (scheme + host, no path,
# no trailing slash), e.g. the current Vercel deployment:
#   CORS_ALLOWED_ORIGINS=https://jonehotel.vercel.app
CORS_ALLOWED_ORIGINS=https://jonehotel.vercel.app
CSRF_TRUSTED_ORIGINS=https://jonehotel.vercel.app

# --- JWT -------------------------------------------------------------------
# Optional dedicated signing key (falls back to DJANGO_SECRET_KEY if blank)
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Paystack --------------------------------------------------------------
# From https://dashboard.paystack.com/#/settings/developers
# The SECRET key must never be exposed to the frontend (it lives ONLY on the
# backend host — never in Vercel or any frontend configuration).
# Configure Paystack webhook URL to: https://<api-host>/api/payments/webhook/
# Required events: charge.success, refund.pending, refund.processing,
# refund.processed, refund.failed, and refund.needs-attention if available.
# Dashboard note: to make the hotel absorb Paystack transaction charges, keep
# Settings -> Preferences -> Transaction fees -> Pass fees to customers unchecked.
PAYSTACK_SECRET_KEY=
# Optional: the public key is not currently used by the redirect checkout flow.
PAYSTACK_PUBLIC_KEY=

# --- Backblaze B2 (media storage; S3-compatible) ---------------------------
# ALL FOUR must be set for uploads to go to B2. If any is missing the app falls
# back to the local disk, which is EPHEMERAL on Render (uploads vanish on every
# deploy/restart) — check with: python manage.py check_media_storage
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
# Must include the scheme, e.g. https://s3.us-west-004.backblazeb2.com
BACKBLAZE_ENDPOINT=
# Optional: overrides the region parsed from the endpoint (e.g. us-west-004)
BACKBLAZE_REGION=
# Optional: your B2 friendly-URL/CDN host for serving media (no scheme needed)
MEDIA_CUSTOM_DOMAIN=
# Optional: absolute base URL used to build media links when no HTTP request is
# available (Celery tasks, management commands). Only needed with LOCAL media.
MEDIA_PUBLIC_BASE_URL=
# Development only: set True to exercise the real B2 backend locally.
USE_B2_IN_DEV=False

# --- Email (transactional) --------------------------------------------------
# PRODUCTION TRANSPORT: Brevo's HTTPS transactional API. Email is delivered
# SYNCHRONOUSLY over https://api.brevo.com/v3/smtp/email during the request —
# no SMTP port, no Celery, no Redis is involved. This is REQUIRED on Render
# Free, which blocks outbound SMTP ports (25/465/587) entirely.
#
#   BREVO_API_KEY: create under Brevo dashboard → SMTP & API → API keys
#                  (an API key "xkeysib-…", NOT an SMTP key).
#   DEFAULT_FROM_EMAIL: MUST use a sender address VERIFIED in Brevo
#                  (Senders, Domains & Dedicated IPs → Senders), e.g.
#                  J-one hotel & lodge <agbo33010@gmail.com>
#   EMAIL_PROVIDER: production pins "brevo" by default; set "django" only to
#                  force the classic Django EMAIL_BACKEND path.
#
# Verify the full chain anytime with:
#   python manage.py brevo_check                # config + auth + sender
#   python manage.py brevo_check --send you@x   # + one real delivery
BREVO_API_KEY=
# EMAIL_PROVIDER=brevo
#
# Development defaults to the console backend (emails printed in terminal,
# nothing leaves the machine). The SMTP variables below are only used when
# EMAIL_PROVIDER=django with an SMTP EMAIL_BACKEND — e.g. local Gmail testing.
# They are NOT used (and not needed) for production Brevo delivery.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# TLS (STARTTLS, port 587) and SSL (implicit TLS, port 465) are mutually
# exclusive. Use ONE. Brevo and Gmail both use TLS on port 587.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Brevo: your SMTP login (looks like 9xxxxxx@smtp-brevo.com).
EMAIL_HOST_USER=
# Brevo: the generated SMTP KEY (Master Password), NOT your login password.
# (Gmail alternative: a 16-character App Password, not the account password.)
# Never commit a real value.
EMAIL_HOST_PASSWORD=
# Seconds before the provider request (Brevo HTTPS or SMTP) is aborted.
EMAIL_TIMEOUT=20
# MUST be an address verified as a Sender in your Brevo account.
# Do NOT wrap the whole value in quotes in hosting dashboards.
DEFAULT_FROM_EMAIL=J-one hotel & lodge <agbo33010@gmail.com>
# Comma-separated staff inboxes for operational enquiry/cancellation/refund alerts.
# If blank, the configured hotel email is used.
HOTEL_NOTIFICATION_EMAILS=

# --- Redis / Celery --------------------------------------------------------
# REDIS_URL is a PRODUCTION variable: it is the Celery broker/result backend
# and the cache location on the deployed worker + web services.
#
# DEVELOPMENT NEEDS NONE OF THIS. The development settings force eager,
# in-process task execution with an in-memory broker and NO result backend,
# so a local run never requires (or even contacts) Redis:
#   * background emails print to the terminal via the console backend;
#   * to test REAL SMTP delivery locally, set EMAIL_BACKEND to the SMTP
#     backend above — delivery then runs on a background thread, still
#     without Redis or a worker.
# To exercise the real Redis broker + Celery worker architecture locally, run
# with production-style settings instead of flipping these values.
REDIS_URL=redis://127.0.0.1:6379/0
# Production only: False (default) = tasks run on Celery workers via Redis.
CELERY_TASK_ALWAYS_EAGER=False

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=5
